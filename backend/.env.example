# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database (Neon cloud Postgres) ---
# Pooled connection string. Get from your Neon project dashboard → Connection details → Pooled.
# Either scheme works (we auto-prefix psycopg3 internally):
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Redis (Phase 12) ---
# Dev (local sidecar): keep both lines. COMPOSE_PROFILES=local-redis makes `docker compose up`
#   start the bundled redis:7-alpine container; REDIS_URL points at it via Docker DNS.
# Prod: drop COMPOSE_PROFILES (so the local sidecar is skipped) and replace REDIS_URL with a
#   managed-Redis connection string. Redis Cloud's free 30 MB tier looks like:
#     REDIS_URL=rediss://default:<PASSWORD>@redis-12345.c10.us-east-1-2.ec2.redns.redis-cloud.com:12345
REDIS_URL=redis://redis:6379/0
COMPOSE_PROFILES=local-redis

# --- Firebase (Phase 2) ---
# FIREBASE_PROJECT_ID=smartcalories-dev
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json

# --- AI providers (Phase 6+7) ---
# Models are tried in this order; FallbackModel falls through on 429/503/timeout.
# All three providers below offer a genuinely free tier (subject to rate caps).
#
# Gemini — https://ai.google.dev (Google AI Studio key)
# GEMINI_API_KEY=your-google-ai-studio-key
#
# Groq — https://console.groq.com (Llama 3.3 70B + Gemma 2, fast & free)
# GROQ_API_KEY=your-groq-key
#
# OpenRouter — https://openrouter.ai (rotating `:free` Llama/Gemma builds)
# OPENROUTER_API_KEY=your-openrouter-key
#
# Ollama (local, offline last-resort) — install Ollama, then `ollama pull gemma4:e4b`. Gemma 4
# has native tool calling + vision so it actually works as a fallback, not just text.
# Mac/Linux host: http://localhost:11434/v1
# From inside the api container: http://host.docker.internal:11434/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=gemma4:e4b

# --- Web ---
ALLOWED_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=dev
