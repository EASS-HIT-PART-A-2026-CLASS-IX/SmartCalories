# Copy to backend/.env and fill in. Never commit the real .env.
#
# NOTE: `docker compose up` is SELF-CONTAINED — it runs its own Postgres + Redis containers and
# ignores DATABASE_URL / REDIS_URL below. Those two matter only for non-Docker runs
# (`uv run uvicorn ...`) and for production (render.yaml). Everything else here IS read by compose.

# --- Environment ---
# dev | test | prod. `dev` enables the `demo-token` escape hatch + /auth/demo seeding.
ENVIRONMENT=dev

# --- App secret ---
# Derives the Fernet key that encrypts users' stored LLM API keys at rest. MUST be set in prod;
# dev falls back to an insecure constant (with a logged warning). Generate: `openssl rand -hex 32`.
SECRET_KEY=change-me-in-prod

# --- Database (non-Docker / prod only; compose uses its own Postgres container) ---
# Non-Docker dev defaults to SQLite if unset. For Postgres (e.g. Neon) set a URL — either scheme
# works (the psycopg3 prefix is added automatically):
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Redis (non-Docker / prod only; compose uses its own Redis container) ---
# Backs the rate-limit middleware + the refresher's rollup cache. Unset → the limiter falls open
# (fine for local dev).
# REDIS_URL=redis://localhost:6379/0

# --- Async refresher (compose `refresher` worker) ---
# How often the worker re-runs scripts/refresh.py, in seconds. Read by compose; unset → 3600 (1h).
REFRESH_INTERVAL_SECONDS=3600

# --- Firebase (auth) ---
# FIREBASE_PROJECT_ID=smartcalories-dev
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json
# ...or pass the service-account JSON as a string instead of a file path:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}

# --- LLM providers (all optional; the chat agent tries them in THIS order) ---
# 1) Anthropic (Claude) — PAID, no free tier; tried FIRST when set. https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_FALLBACK_MODELS=claude-haiku-4-5-20251001,claude-sonnet-4-6
#
# 2) Gemini — free tier, multimodal (also powers photo→nutrition). https://ai.google.dev
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash   # no -lite (too weak)
#
# 3) Groq — free (Llama 3.3 70B + Gemma 2), fast. https://console.groq.com
# GROQ_API_KEY=your-groq-key
#
# 4) OpenRouter — rotating `:free` Llama/Gemma builds. https://openrouter.ai
# OPENROUTER_API_KEY=your-openrouter-key
#
# 5) Ollama (local open-source LLM) — works with NO cloud key. Easiest path: the compose
#    `local-llm` profile bundles Ollama + auto-pulls the model:
#       cd backend && docker compose --profile local-llm up --build
#    (first run downloads ~2 GB; CPU inference is slow). The model must support tool-calling —
#    llama3.2:3b is the default (Gemma's tool-calling on Ollama is unreliable). To point at your
#    own/host Ollama instead, set these (host: localhost; from the api container: host.docker.internal):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.2:3b

# --- Web ---
ALLOWED_ORIGINS=["http://localhost:5173"]
