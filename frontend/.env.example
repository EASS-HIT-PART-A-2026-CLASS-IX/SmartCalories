# Copy to frontend/.env and fill in. Never commit the real .env.
# Vite only exposes vars prefixed with VITE_. In compose, frontend/.env is loaded into the web
# container automatically.

# Backend API base URL (the FastAPI service).
VITE_API_BASE=http://localhost:9000

# --- Firebase Web SDK (Firebase console → Project settings → Web app) ---
# Without these, Google sign-in is hidden and the app runs in demo-only mode; the rest of the
# UI still loads.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_APP_ID=
